<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="1dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_action_back" />

        <TextView
            android:id="@+id/tv_user_name_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/btn_back"
            android:layout_marginLeft="8dp"
            android:text="@string/activity_user_profile_7528"
            android:textSize="18sp"
            android:textColor="#333333"
            android:maxWidth="200dp"
            android:ellipsize="end"
            android:maxLines="1" />

    </RelativeLayout>

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/loading_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/activity_user_profile_52a0"
            android:textSize="14sp"
            android:textColor="#999999" />

    </LinearLayout>

    <!-- 内容（紧贴 title_bar，无橙线/阴影） -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0dp"
        android:visibility="gone">

        <!-- 封面横幅：有封面时显示，无封面时 GONE（无间隙） -->
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="#E8E8E8"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- 用户信息卡片 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bili_default_avatar" />

            <Button
                android:id="@+id/btn_follow"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:background="#FF8C00"
                android:text="关注"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/user_info_texts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/iv_avatar"
                android:layout_alignParentRight="true"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="84dp"
                android:orientation="vertical">

                <!-- 用户名 · 头衔 -->
                <TextView
                    android:id="@+id/tv_user_sign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_oid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#999999" />

                <!-- 性别 · 入站时间 · LEVEL -->
                <TextView
                    android:id="@+id/tv_level"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- 粉丝 / 关注 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_fans"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="粉丝 0"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tv_following"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="关注 0"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- 简介 -->
                <TextView
                    android:id="@+id/tv_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:maxLines="4"
                    android:ellipsize="end" />

                <!-- 旧按钮保留 id，默认隐藏 -->
                <Button
                    android:id="@+id/btn_medal_wall"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_more_info"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:visibility="gone" />

            </LinearLayout>

        </RelativeLayout>

        <!-- 视频 | 动态 Tab -->
        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_video"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="视频"
                    android:textSize="15sp"
                    android:textColor="#FF8C00"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/tab_video_underline"
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:background="#FF8C00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tab_blog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="动态"
                    android:textSize="15sp"
                    android:textColor="#666666"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/tab_blog_underline"
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:background="#00000000" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- 视频/动态：可左右滑动 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5">

            <cn.ottohub.oh2013.widget.SwipeableViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 加载中 -->
            <ProgressBar
                android:id="@+id/video_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- 空视图 -->
            <TextView
                android:id="@+id/video_empty_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="50dp"
                android:text="@string/activity_user_profile_6682"
                android:textSize="13sp"
                android:textColor="#999999"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
